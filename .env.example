# Copy to `.env.local` and fill in.

# Both keys are optional. When set, the app uses them server-side and the key
# screens are skipped. Requests are proxied through /api/kie, /api/kie-upload
# and /api/fish, so the keys never reach the browser.

# Kie.ai — required for image/video/lip-sync generation.
KIE_API_KEY=

# Fish Audio — optional, enables AI voice generation/cloning in Lip Sync.
FISH_API_KEY=
